{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/families_treemap.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "fill",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "family",
            "type": "nominal",
            "title": "Bird family"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Species"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "color": "#FFFFFF",
        "fontSize": 15,
        "fontWeight": "bold",
        "limit": 140
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "ym",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#253745",
      "titleColor": "#253745",
      "gridColor": "#E5EAF0",
      "tickColor": "#B0BFC7",
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "labelFontSize": 13,
      "titleFontSize": 15,
      "labelPadding": 7,
      "titlePadding": 10
    },
    "legend": {
      "labelColor": "#253745",
      "titleColor": "#253745",
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "labelLimit": 185,
      "titleLimit": 200
    },
    "title": {
      "font": "Open Sans",
      "color": "#253745",
      "fontSize": 17
    },
    "font": "Open Sans"
  }
}